---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import Section from '@components/ui/Section.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import LogoCard from '@components/cards/LogoCard.astro';
import OtherCategories from '@components/sections/OtherCategories.astro';
import { techJapan, techOverseas } from '@data/portfolio';

// Sector pills cycle through the brand colours.
const tones = ['navy', 'teal', 'orange'] as const;
---

<BaseLayout title="Technologies & Lifestyle" preloadImage="/images/photos/vb-004.jpeg">
  <PageHeader title="Technologies & Lifestyle" subtitle="テクノロジーとライフスタイル" image="/images/photos/vb-004.jpeg">
    <p>
      バリュービルドでは、長年にわたり、IT関連企業への投資を積極的に行なっています。すでに上場を果たした企業もあり、海外のIT関連ファンドも含め、幅広いネットワークを築いてきました。また、IT関連企業だけではなく、製造業や福祉事業などの人々の生活に欠かせない分野にも投資を行なっています。「仕事は社会貢献である」という観点から、人々にとってなくてはならない産業、また、世の中の課題を解決する革新的なアイデアに注目しています。
    </p>
  </PageHeader>

  <Section>
    <SectionTitle title="In Japan" />
    <div class="grid grid--5 logo-grid">
      {techJapan.map((c, i) => <LogoCard name={c.name} logo={c.logo} url={c.url} caption={c.sector} captionTone={tones[i % 3]} />)}
    </div>

    <div class="overseas">
      <SectionTitle title="Overseas" />
      <div class="grid grid--5 logo-grid">
        {techOverseas.map((c, i) => <LogoCard name={c.name} logo={c.logo} url={c.url} caption={c.sector} captionTone={tones[(i + 1) % 3]} />)}
      </div>
    </div>
  </Section>

  <OtherCategories current="technology" />
</BaseLayout>

<style lang="scss">
  .logo-grid {
    gap: 2.5rem 1.25rem;
    align-items: start;
  }

  .overseas {
    margin-top: $section-space;
  }
</style>
