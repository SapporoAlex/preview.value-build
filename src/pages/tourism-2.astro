---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import Section from '@components/ui/Section.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import PhotoCard from '@components/cards/PhotoCard.astro';
import OtherCategories from '@components/sections/OtherCategories.astro';
import { tourismPortfolio } from '@data/portfolio';
---

<BaseLayout title="Tourism" preloadImage="/images/photos/tourism-banner.jpg">
  <PageHeader title="Tourism" subtitle="観光事業" image="/images/photos/tourism-banner.jpg">
    <p>
      『旅』という非日常の体験は、今や人間にとって三大欲求に匹敵するほどに大きな欲となって現れるようになりました。そして、多くの観光資源を有している日本は、世界的に見ても人気の旅行先です。
    </p>
    <p>
      今後見込まれる、更なる観光事業の発展・拡大を見据え、旅行代理店や民泊運営会社、ブティックホテルなど、ツーリズム関連企業や不動産への投資にも力を入れております。
    </p>
  </PageHeader>

  <Section>
    <SectionTitle variant="display" title="Portfolio" subtitle="事例紹介" />
    <div class="grid grid--3 tourism-grid">
      {tourismPortfolio.map((item, i) => <PhotoCard title={item.name} image={item.image} url={item.url} paragraphs={item.paragraphs} delay={(i % 3) * 120} />)}
    </div>
  </Section>

  <!-- Connect / network -->
  <Section background="grey">
    <SectionTitle variant="display" title="Connect" subtitle="ネットワークの構築" />
    <div class="connect">
      <img class="connect__image" src="/images/photos/connect.jpg" alt="" loading="lazy" data-reveal="up" />
      <div class="connect__content" data-reveal="up" style="--reveal-delay: 150ms">
        <h3 class="connect__title">投資先同士の連携&ネットワークの拡充</h3>
        <div class="connect__text prose">
          <p>観光分野において、バリュービルドが投資先を決める上で重視しているのが『シナジー』です。</p>
          <p>ビジネスの成功の鍵は、いかに自社の強みを強化し、相乗効果が見込める他社と連携をすることが成功の鍵であると当社は考えます。</p>
          <p>
            参入障壁の低い観光分野においては、ユニークなサービスを展開し続けることが企業の生存率を高めます。バリュービルドでは投資先の創業者たちが円滑なコミュニケーションをとり合い、各々のネットワークを紹介できる関係性の構築づくりをサポートします。そのことにより、多くのコラボレーションが生れています。
          </p>
        </div>
      </div>
    </div>
  </Section>

  <OtherCategories current="tourism" />
</BaseLayout>

<style lang="scss">
  .tourism-grid {
    gap: 3.5rem 2rem;
  }

  .connect {
    display: grid;
    gap: 2.5rem;
    align-items: center;

    @include mq(lg) {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    &__image {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      box-shadow: 10px 10px 0 0 $color-teal;
    }

    &__title {
      margin-bottom: 1.25rem;
      font-family: $font-body;
      font-size: clamp(1.05rem, 2vw, 1.1875rem); // 19px
      font-weight: 500;
      letter-spacing: 2px;
      color: $color-text;
    }

    &__text {
      @include text-accent;
    }
  }
</style>
