---
// Numbered "story" block on the About page, matching the original layout:
//   - large headline that flips into view in 3D
//   - image on the left, number + title + text on the right
//   - a long teal diagonal line behind everything, cutting between the
//     number ("001") and the title, and running up behind the headline
import type { AboutFeature } from '@data/about';
import DiagonalLine from '@components/ui/DiagonalLine.astro';

interface Props {
  feature: AboutFeature;
  eager?: boolean; // first block on the page: load its image immediately (it's the main visible image)
}

const { feature, eager = false } = Astro.props;
---

<section id={feature.id} class="feature-story">
  <div class="container">
    <h2 class="feature-story__headline" data-reveal="flip">
      {feature.headline.split('\n').map((line, i) => (i ? [<br />, line] : line))}
    </h2>

    <div class="feature-story__body">
      <DiagonalLine class="feature-story__line" color="teal" angle={-38.5} length="673px" />

      <div class="feature-story__media" data-reveal="fade">
        <img src={feature.image} alt="" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
      </div>

      <div class="feature-story__content" data-reveal="up" style="--reveal-delay: 150ms">
        <p class="feature-story__number">{feature.number}</p>
        <h3 class="feature-story__title">{feature.title}</h3>
        <div class="feature-story__text prose">
          {feature.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  // Desktop measurements from the original: two 416px columns with a 48px gap,
  // inset 100px from each side of the 1080px content area.
  $inset: 100px;
  $column-gap: 48px;

  .feature-story {
    padding-block: $section-space;
    overflow: hidden;
    // Own stacking context, so the line (z-index: -1) sits behind the text
    // but still in front of the section background.
    isolation: isolate;

    &__headline {
      @include text-headline;
      margin-bottom: 2.5rem;

      @include mq(lg) {
        padding-left: $inset;
        margin-bottom: 3rem;
      }
    }

    &__body {
      position: relative;
      display: grid;
      gap: 2rem;

      @include mq(lg) {
        grid-template-columns: 1fr 1fr;
        gap: $column-gap;
        padding-inline: $inset;
        align-items: start;
      }
    }

    // The line's lower-left end starts just left of the text column and
    // 198px below the top of the image, then rises at 38.5° — so it passes
    // between the number and the title, and on up behind the headline.
    // DiagonalLine is a child component, so it is styled with :global()
    // under the scoped __body (Astro scoped styles don't reach into children).
    &__body :global(.feature-story__line) {
      display: none;
      z-index: -1;

      @include mq(lg) {
        display: block;
        top: 198px;
        left: calc(50% + #{$column-gap * 0.5} - 160px);
      }
    }

    &__media img {
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
    }

    &__number {
      font-family: $font-heading;
      font-size: 1.0625rem; // 17px
      font-weight: 600;
      line-height: 1.6;
      letter-spacing: 2px;
      color: $color-text;
    }

    &__title {
      margin-top: 1.5rem;
      font-family: $font-body;
      font-size: clamp(1.1rem, 2vw, 1.375rem); // 22px
      font-weight: 500;
      line-height: 1.6;
      letter-spacing: 2px;
      color: $color-text;
    }

    &__text {
      @include text-body;
      margin-top: 1.5rem;
      font-size: 0.9375rem;
      letter-spacing: 1px;
    }
  }
</style>
