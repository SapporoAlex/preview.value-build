---
// About page feature, desktop layout (≥ 981px):
// large statement with a thin diagonal teal line behind it, then the photo
// and the numbered text, overlapping the statement by 72px.
import type { AboutFeature } from '@data/about';
import Lines from '@components/ui/Lines.astro';

interface Props {
  feature: AboutFeature;
  minHeight?: string; // the last feature section has a minimum height on the original
}

const { feature, minHeight } = Astro.props;
---

<section class="sec feature hide-tablet hide-phone" id={feature.id} style={minHeight ? `min-height: ${minHeight}` : undefined}>
  <div class="row feature__head">
    <div class="col col-4-4">
      <p class="mod feature__headline"><Lines text={feature.headline} /></p>
      <div class="mod feature__line" aria-hidden="true"></div>
    </div>
  </div>
  <div class="row feature__body">
    <div class="col col-1-2">
      <div class="mod"><img src={feature.image} alt="" width="416" height="277" loading="lazy" /></div>
    </div>
    <div class="col col-1-2">
      <p class="mod feature__number">{feature.number}</p>
      <h3 class="mod feature__title"><Lines text={feature.title} /></h3>
      <div class="mod feature__text">
        {feature.paragraphs.map((p, i) => <p>{i === 0 && feature.firstParagraphSmall ? <span class="is-small">{p}</span> : p}</p>)}
        {feature.trailingBlankLine && <p>&nbsp;</p>}
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .feature {
    margin-top: -100px;

    &__head,
    &__body {
      padding-left: 100px;
      padding-right: 100px;
    }

    // The original overlaps by 72px, but its floated columns can't rise
    // above the line above, so the photo starts right under it.
    &__body {
      margin-top: -4%;

      @include wide {
        margin-top: -54px;
      }
    }

    &__headline {
      @include font($font-heading, 35px, 600, 1.5em, 4px);
    }

    // Divi divider module: 71% wide, right aligned, rotated 142° behind the content.
    &__line {
      position: relative;
      z-index: -1;
      width: 71%;
      height: 23px;
      margin: 0 0 0 auto !important;
      transform: scaleX(1.04) scaleY(1.04) rotateX(358deg) rotateY(0deg) rotateZ(142deg);

      &::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        border-top: 2px solid $color-teal;
      }
    }

    img {
      width: 100%;
      height: auto;
    }

    &__number {
      @include font($font-heading, 17px, 600, null, 2px);
    }

    &__title {
      padding-bottom: 0;
      background: $color-white;
      @include font($font-body, 22px, 500, 1.8em, 2px);
      color: $color-text;
    }

    &__text {
      @include font($font-body, 16px, 300, 1.8em, 1px);

      .is-small {
        font-size: 14px;
      }
    }
  }
</style>
