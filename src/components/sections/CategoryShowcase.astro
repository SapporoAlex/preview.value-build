---
// Portfolio overview row: photo with two rounded corners + a text card that
// overlaps its lower corner, with coloured top/bottom rules and a diagonal
// accent line. Alternates sides with `reverse`.
import type { Category } from '@data/portfolio';
import DiagonalLine from '@components/ui/DiagonalLine.astro';
import MoreLink from '@components/ui/MoreLink.astro';

interface Props {
  category: Category;
  reverse?: boolean;
}

const { category, reverse = false } = Astro.props;
// The accent line uses the opposite brand colour to the card rules (original design).
const lineColor = category.accent === 'orange' ? 'navy' : 'orange';
---

<article
  class:list={['category-showcase', `category-showcase--${category.accent}`, { 'category-showcase--reverse': reverse }]}
>
  <div class="category-showcase__media" data-reveal="fade">
    <img src={category.image} alt="" loading="lazy" />
  </div>

  <div class="category-showcase__card" data-reveal="up" style="--reveal-delay: 150ms">
    <DiagonalLine class="category-showcase__line" color={lineColor} angle={reverse ? -138 : -39} length="295px" />
    <h2 class="category-showcase__title">
      {category.href ? <a href={category.href}>{category.overviewTitle ?? category.title}</a> : (category.overviewTitle ?? category.title)}
    </h2>
    <p class="category-showcase__summary">{category.summary}</p>
    {category.href && <MoreLink href={category.href} variant="button" color={category.accent} />}
  </div>
</article>

<style lang="scss">
  // Desktop proportions follow the original 1080px layout:
  // photo 416×277, card 406 wide, overlapping the photo by 92px
  // and starting 150px below its top; the pair is offset 200px from
  // the photo side and 150px from the card side.
  .category-showcase {
    --accent: #{$color-navy};
    --corner: clamp(3rem, 12vw, 90px);

    display: grid;

    &--orange {
      --accent: #{$color-orange};
    }

    @include mq(lg) {
      grid-template-columns: 324fr 92fr 314fr;
      padding-inline: 18.5% 13.9%;
    }

    &--reverse {
      @include mq(lg) {
        grid-template-columns: 314fr 92fr 324fr;
        padding-inline: 13.9% 18.5%;
      }
    }

    &__media {
      @include mq(lg) {
        grid-row: 1;
        grid-column: 1 / 3;
      }
    }

    &--reverse &__media {
      @include mq(lg) {
        grid-column: 2 / 4;
      }
    }

    // Rounded top-left + bottom-right; mirrored when reversed.
    &__media img {
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border-radius: var(--corner) 0;
    }

    &--reverse &__media img {
      border-radius: 0 var(--corner);
    }

    &__card {
      position: relative;
      z-index: 1;
      margin: -3rem 1rem 0;
      padding: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 2vw, 1.75rem);
      background: $color-white;
      border-block: 3px solid var(--accent);

      @include mq(lg) {
        grid-row: 1;
        grid-column: 2 / 4;
        margin: 150px 0 0;
      }
    }

    &--reverse &__card {
      @include mq(lg) {
        grid-column: 1 / 3;
      }
    }

    // Normal: line rises to the top-right above the card.
    // Reverse: mirrored, rises to the top-left.
    // DiagonalLine is a child component, so it is styled with :global()
    // under a scoped parent (Astro scoped styles don't reach into children).
    &__card :global(.category-showcase__line) {
      top: -3.5rem;
      left: 54%;

      @include mq-down(lg) {
        display: none;
      }
    }

    &--reverse &__card :global(.category-showcase__line) {
      left: 44%;
    }

    &__title {
      font-family: $font-heading;
      font-weight: 400;
      font-size: clamp(1.15rem, 2vw, 1.375rem); // 22px
      line-height: 1.1;
      letter-spacing: 2px;
      color: $color-navy;

      a:hover {
        opacity: 0.7;
      }
    }

    &__summary {
      margin-block: 0.75rem 1.25rem;
      font-family: $font-body;
      font-weight: 400;
      font-size: 0.9375rem; // 15px
      line-height: 1.8;
      letter-spacing: 2px;
      color: $color-navy;
    }
  }
</style>
