---
// Home page intro: brand title + tagline, then the split photo band
// with the two message boxes over the city photo.
import { site } from '@data/site';
---

<section class="home-hero">
  <div class="home-hero__intro container">
    <h1 class="home-hero__title" data-reveal="up">{site.name}</h1>
    <p class="home-hero__tagline" data-reveal="up" style="--reveal-delay: 200ms">{site.tagline}</p>
  </div>

  <div class="home-hero__band">
    <!-- One image file split into two halves with background-position -->
    <div class="home-hero__photo home-hero__photo--city" role="presentation">
      <div class="home-hero__message">
        <p class="home-hero__box" data-reveal="left">あなたの起業家としての夢を、</p>
        <p class="home-hero__box home-hero__box--offset" data-reveal="left" style="--reveal-delay: 250ms">
          バリュービルドと一緒に叶えませんか？
        </p>
      </div>
    </div>
    <div class="home-hero__photo home-hero__photo--people" role="presentation"></div>
  </div>
</section>

<style lang="scss">
  .home-hero {
    &__intro {
      padding-block: clamp(4rem, 10vw, 7rem) clamp(3rem, 7vw, 5rem);
      text-align: center;
    }

    &__title {
      font-family: $font-heading;
      font-weight: 600;
      font-size: clamp(1.75rem, 5vw, 2.5rem); // 40px
      line-height: 1.2;
      letter-spacing: 0.175em;
      color: $color-navy;
    }

    &__tagline {
      margin-top: 1rem;
      font-family: $font-body;
      font-weight: 500;
      font-size: clamp(0.9rem, 2vw, 1.0625rem); // 17px
      letter-spacing: 2px;
      color: $color-navy;
    }

    // --- Photo band ---
    &__band {
      display: grid;

      @include mq(md) {
        grid-template-columns: 1fr 1fr;
      }
    }

    // The source image is two photos side by side. Each column shows one
    // half: a pseudo-element twice the column's width is anchored left or right.
    &__photo {
      position: relative;
      min-height: clamp(260px, 40vw, 460px);
      overflow: hidden;

      &::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 200%;
        background: url('/images/brand/hero.jpg') center / cover no-repeat;
      }

      &--city::before {
        left: 0;
      }

      &--people::before {
        right: 0;
      }
    }

    &__message {
      position: absolute;
      left: clamp(1rem, 8vw, 5rem);
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-width: calc(100% - 2rem);
    }

    &__box {
      padding: 0.6rem 1.25rem;
      background: rgba($color-white, 0.95);
      font-family: $font-body;
      font-size: clamp(0.85rem, 1.6vw, 1rem);
      font-weight: 500;
      letter-spacing: 3px;
      color: $color-text;

      &--offset {
        margin-left: clamp(0rem, 3vw, 2rem);
      }
    }
  }
</style>
