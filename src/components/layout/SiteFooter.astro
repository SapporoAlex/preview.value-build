---
// Navy footer: address / phone / email with icons, then the copyright line.
// Spacing follows the original: a 32px icon column, 15px gap, 28px lines.
import { site } from '@data/site';
const { contact } = site;

// Inline icons (the original used icon-font glyphs at 17px).
const icons = {
  pin: 'M12 1.5a7.5 7.5 0 0 0-7.5 7.5c0 5.6 7.5 13.5 7.5 13.5s7.5-7.9 7.5-13.5A7.5 7.5 0 0 0 12 1.5zm0 10.3a2.8 2.8 0 1 1 0-5.6 2.8 2.8 0 0 1 0 5.6z',
  phone:
    'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z',
};
---

<footer class="footer">
  <div class="row footer__contacts">
    <div class="footer__item">
      <svg class="footer__icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.pin} /></svg>
      <p class="footer__text">{contact.address}</p>
    </div>
    <a class="footer__item" href={contact.phoneHref}>
      <svg class="footer__icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.phone} /></svg>
      <p class="footer__text">{contact.phone}</p>
    </a>
    <a class="footer__item" href={contact.emailHref}>
      <svg class="footer__icon footer__icon--outline" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="2" y="5" width="20" height="14" />
        <path d="M2 5l10 8 10-8M2 19l7.5-7M22 19l-7.5-7" />
      </svg>
      <p class="footer__text">{contact.email}</p>
    </a>
  </div>

  <div class="row footer__copyright">
    <p>{site.copyright}</p>
  </div>
</footer>

<style lang="scss">
  .footer {
    padding-top: 40px;
    background: $color-navy;
    color: $color-white;

    // Plain stacked rows (not the side-by-side column layout).
    .row {
      display: block;
    }

    &__contacts {
      padding: 0;
    }

    &__item {
      display: flex;
      color: $color-white;
    }

    &__icon {
      flex: none;
      width: 17px;
      height: 17px;
      margin-right: 30px; // 32px icon column + 15px gap
      fill: $color-white;

      &--outline {
        fill: none;
        stroke: $color-white;
        stroke-width: 1.6;
      }
    }

    &__text {
      padding-bottom: 10px;
      @include font($font-body, 15px, 300, 1.2em, 2px);
    }

    &__copyright {
      text-align: center;

      // Phone: the line sits directly under the contact lines.
      @include phone {
        margin-top: -30px;
      }
    }
  }
</style>
