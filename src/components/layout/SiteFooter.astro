---
// Navy footer: address / phone / email with icons, then copyright.
import { site } from '@data/site';
const { contact } = site;

// Simple inline icons (no icon font needed).
const icons = {
  pin: 'M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z',
  phone:
    'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z',
  mail: 'M3 5h18v14H3V5zm2 2v.4l7 4.6 7-4.6V7H5zm14 2.8-7 4.6-7-4.6V17h14V9.8z',
};
---

<footer class="site-footer">
  <div class="container">
    <ul class="site-footer__contacts" role="list">
      <li class="site-footer__contact">
        <svg class="site-footer__icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.pin} /></svg>
        <address>{contact.address}</address>
      </li>
      <li class="site-footer__contact">
        <svg class="site-footer__icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.phone} /></svg>
        <a href={contact.phoneHref}>{contact.phone}</a>
      </li>
      <li class="site-footer__contact">
        <svg class="site-footer__icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.mail} /></svg>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </li>
    </ul>
    <p class="site-footer__copyright">{site.copyright}</p>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    padding-block: 2.75rem 2rem;
    background: $color-navy;
    color: $color-white;

    &__contacts {
      display: grid;
      gap: 0.4rem;
      margin: 0;
    }

    &__contact {
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      font-family: $font-body;
      font-weight: 300;
      font-size: 0.95rem;
      letter-spacing: 2px;
      line-height: 1.6;

      address {
        font-style: normal;
      }

      a:hover {
        opacity: 0.7;
      }
    }

    &__icon {
      flex-shrink: 0;
      width: 16px;
      height: 16px;
      margin-top: 0.2em;
      fill: currentColor;
    }

    &__copyright {
      margin-top: 1.75rem;
      font-family: $font-accent;
      font-weight: 500;
      font-size: 1rem;
      text-align: center;
    }
  }
</style>
