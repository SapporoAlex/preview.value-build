---
// Site header, matching the original Divi header:
// - Desktop (≥ 981px): fixed white bar, 64px tall, shrinks to 54px once the
//   page scrolls. "Portfolio" opens a dropdown on hover/focus.
// - Tablet/phone: 80px bar that scrolls away with the page; the blue menu
//   icon slides a panel down under it.
import { site, mainNav } from '@data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === currentPath;
const isActive = (href: string, children?: { href: string }[]) =>
  isCurrent(href) || (children ?? []).some((child) => isCurrent(child.href));
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__logo" href="/">
      <img src={site.logo} alt={site.name} width="70" height="72" />
    </a>

    <!-- Desktop menu -->
    <nav class="nav" aria-label="Main">
      <ul class="nav__list" role="list">
        {
          mainNav.map((item) => (
            <>
              <li class:list={['nav__item', { 'is-active': isActive(item.href, item.children) }]}>
                <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                {item.children && (
                  <ul class="nav__sub" role="list">
                    {item.children.map((child) => (
                      <li class:list={['nav__sub-item', { 'is-active': isCurrent(child.href) }]}>
                        <a class="nav__sub-link" href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>{' '}
            </>
          ))
        }
      </ul>
    </nav>

    <!-- Tablet/phone menu -->
    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
        <rect x="6" y="9" width="20" height="2.5" />
        <rect x="6" y="15" width="20" height="2.5" />
        <rect x="6" y="21" width="20" height="2.5" />
      </svg>
    </button>

    <div class="mobile-menu" id="mobile-menu" data-menu>
      <ul class="mobile-menu__list" role="list">
        {
          mainNav.map((item) => (
            <li class:list={['mobile-menu__item', { 'has-children': item.children }]}>
              <a href={item.href}>{item.label}</a>
              {item.children && (
                <ul role="list">
                  {item.children.map((child) => (
                    <li class="mobile-menu__item">
                      <a href={child.href}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  // Desktop: shrink the header once the page has scrolled (Divi "fixed header").
  const onScroll = () => header?.classList.toggle('is-fixed', window.scrollY > 0);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Tablet/phone: slide the menu panel open/closed.
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
    if (menu) menu.style.maxHeight = open ? `${menu.scrollHeight}px` : '';
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

<style lang="scss">
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 99999;
    height: $header-height;
    background: $color-white;
    box-shadow: 0 1px 0 rgba($color-black, 0.1);
    font-family: $font-nav;
    transition:
      height $transition-base,
      box-shadow $transition-base;

    &.is-fixed {
      height: $header-height-fixed;
      box-shadow: 0 0 7px rgba($color-black, 0.1);
    }

    @include tablet-down {
      position: absolute;
      height: auto;

      &.is-fixed {
        height: auto;
        box-shadow: 0 1px 0 rgba($color-black, 0.1);
      }
    }

    &__inner {
      position: relative;
      height: 100%;
      padding: 0 32px 0 30px;

      @include tablet-down {
        width: $row-width;
        height: $header-height-mobile;
        margin: 0 auto;
        padding: 0;
      }
    }

    // Logo: 87% of the bar height on desktop, 54% on mobile, vertically centred.
    &__logo {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 35px;
      display: flex;
      align-items: center;

      img {
        width: auto;
        height: 87%;
        max-height: 56px;
        transition: height $transition-base;

        @include tablet-down {
          height: 43px;
          max-height: none;
        }
      }

      @include tablet-down {
        left: 5px;
      }
    }

    // --- Menu icon (tablet/phone) ---
    &__toggle {
      display: none;

      @include tablet-down {
        position: absolute;
        top: 24px;
        right: 0;
        display: block;
        width: 32px;
        height: 32px;
        padding: 0;
        background: none;
        border: 0;
        fill: $color-divi-blue;
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Desktop menu
  // ---------------------------------------------------------------------------
  .nav {
    position: absolute;
    top: 0;
    right: 32px;
    padding-top: 25px;
    transition: padding $transition-base;

    .is-fixed & {
      padding-top: 20px;
    }

    @include tablet-down {
      display: none;
    }

    &__list {
      margin: 0;
      padding: 0;
      font-size: 16px; // sets the width of the spaces between items
      line-height: 1em;
      white-space: nowrap;
    }

    &__item {
      position: relative;
      display: inline-block;
      padding-right: 22px;

      &:last-child {
        padding-right: 0;
      }
    }

    &__link {
      display: block;
      padding-bottom: 25px;
      font-size: 16px;
      font-weight: 400;
      line-height: 14px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: $color-nav;
      transition:
        opacity $transition-base,
        padding $transition-base;

      .is-fixed & {
        padding-bottom: 20px;
      }

      &:hover {
        opacity: 0.7;
      }
    }

    &__item.is-active > &__link,
    &__sub-item.is-active > &__sub-link {
      color: $color-teal;
    }

    // Dropdown
    &__sub {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 9999;
      width: 270px;
      margin: 0;
      padding: 20px 0;
      background: $color-white;
      border-top: 3px solid $color-salmon;
      box-shadow: 0 2px 5px rgba($color-black, 0.1);
      text-align: left;
      visibility: hidden;
      opacity: 0;
      transition: all 0.2s ease-in-out;
    }

    &__item:hover > &__sub,
    &__item:focus-within > &__sub {
      visibility: visible;
      opacity: 1;
    }

    &__sub-item {
      padding: 0 20px;
      line-height: 2em;
    }

    &__sub-link {
      display: block;
      width: 270px;
      padding: 6px 0;
      font-size: 16px;
      font-weight: 400;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: $color-nav;
      transition: opacity $transition-base;

      &:hover {
        opacity: 0.7;
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Tablet/phone menu panel
  // ---------------------------------------------------------------------------
  .mobile-menu {
    display: none;

    @include tablet-down {
      position: absolute;
      top: $header-height-mobile;
      left: 0;
      right: 0;
      z-index: 9999;
      display: block;
      max-height: 0;
      overflow: hidden;
      visibility: hidden; // closed links can't be focused
      background: $color-white;
      box-shadow: 0 2px 5px rgba($color-black, 0.1);
      transition:
        max-height 0.4s ease-in-out,
        visibility 0s 0.4s;

      .is-open & {
        visibility: visible;
        transition: max-height 0.4s ease-in-out;
      }
    }

    &__list {
      margin: 0;
      padding: 5%;
      border-top: 3px solid $color-divi-blue;
    }

    &__item a {
      display: block;
      padding: 10px 5%;
      border-bottom: 1px solid rgba($color-black, 0.03);
      font-size: 14px;
      font-weight: 600;
      line-height: 23px;
      color: $color-nav;

      &:hover {
        opacity: 0.7;
      }
    }

    // "Portfolio": bold on a light grey band, children indented below.
    .has-children > a {
      padding-right: 0;
      font-weight: 700;
      background: rgba($color-black, 0.03);
    }

    ul ul {
      margin: 0;
      padding-left: 10px;
    }
  }
</style>
