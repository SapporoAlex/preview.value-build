---
// "MORE ー" link.
//   variant="text"   (default) text with a dash that stretches on hover
//   variant="button" filled button (navy or orange), as on the Portfolio page
interface Props {
  href: string;
  label?: string;
  variant?: 'text' | 'button';
  color?: 'navy' | 'orange';
}

const { href, label = 'More', variant = 'text', color = 'navy' } = Astro.props;
---

<a class:list={['more-link', `more-link--${variant}`, `more-link--${color}`]} href={href}>
  <span class="more-link__label">{label}</span>
  <span class="more-link__dash" aria-hidden="true"></span>
</a>

<style lang="scss">
  .more-link {
    --color: #{$color-navy};

    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: $font-heading;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;

    &--orange {
      --color: #{$color-orange};
    }

    &__dash {
      display: block;
      width: 0.9rem;
      height: 2px;
      background: currentColor;
      transition: width $transition-base;
    }

    &:hover &__dash,
    &:focus-visible &__dash {
      width: 1.75rem;
    }

    // --- Text link ---
    &--text {
      color: var(--color);
    }

    // --- Filled button ---
    &--button {
      padding: 0.35rem 0.9rem;
      border: 1px solid var(--color);
      background: var(--color);
      color: $color-white;
      transition:
        background $transition-base,
        color $transition-base;

      &:hover,
      &:focus-visible {
        background: $color-white;
        color: var(--color);
      }
    }
  }
</style>
