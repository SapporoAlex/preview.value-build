---
// Accordion built on native <details>/<summary> (works without JavaScript).
// The script adds a smooth open/close height animation and keeps only
// one item open at a time.
interface Item {
  question: string;
  answer: string[];
}

interface Props {
  items: Item[];
  openFirst?: boolean;
}

const { items, openFirst = true } = Astro.props;
---

<div class="accordion" data-accordion>
  {
    items.map((item, i) => (
      <details class="accordion__item" open={openFirst && i === 0} data-reveal="up" style={`--reveal-delay: ${i * 80}ms`}>
        <summary class="accordion__question">
          <span>{item.question}</span>
          <span class="accordion__icon" aria-hidden="true" />
        </summary>
        <div class="accordion__answer" data-accordion-answer>
          <div class="accordion__answer-inner">
            {item.answer.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </details>
    ))
  }
</div>

<script>
  const DURATION = 400;
  const EASING = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animateHeight(el: HTMLElement, from: number, to: number) {
    return el.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: DURATION, easing: EASING });
  }

  function openItem(item: HTMLDetailsElement) {
    const answer = item.querySelector<HTMLElement>('[data-accordion-answer]');
    item.open = true; // must be open to measure the content
    if (!answer || reduceMotion) return;
    animateHeight(answer, 0, answer.scrollHeight);
  }

  function closeItem(item: HTMLDetailsElement) {
    const answer = item.querySelector<HTMLElement>('[data-accordion-answer]');
    if (!answer || reduceMotion) {
      item.open = false;
      return;
    }
    item.classList.add('is-closing');
    const animation = animateHeight(answer, answer.offsetHeight, 0);
    animation.onfinish = () => {
      item.open = false;
      item.classList.remove('is-closing');
    };
  }

  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((accordion) => {
    const items = [...accordion.querySelectorAll<HTMLDetailsElement>('details')];

    items.forEach((item) => {
      item.querySelector('summary')?.addEventListener('click', (event) => {
        event.preventDefault(); // we handle open/close ourselves to animate it
        if (item.open && !item.classList.contains('is-closing')) {
          closeItem(item);
        } else {
          items.filter((other) => other !== item && other.open).forEach(closeItem);
          openItem(item);
        }
      });
    });
  });
</script>

<style lang="scss">
  .accordion {
    display: grid;
    gap: 0.5rem;

    &__item {
      background: transparent;
      transition: background $transition-base;

      &[open]:not(.is-closing) {
        background: $color-grey-lighter;
      }
    }

    &__question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 1.25rem 1.5rem;
      font-family: $font-body;
      font-weight: 500;
      font-size: 0.95rem;
      letter-spacing: 1px;
      color: $color-text-strong;
      cursor: pointer;
      list-style: none;
      transition: color $transition-fast;

      &::-webkit-details-marker {
        display: none;
      }

      &:hover {
        color: $color-orange;
      }
    }

    // Orange circle with a plus that turns into a minus when open.
    &__icon {
      position: relative;
      flex-shrink: 0;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: $color-orange;

      &::before,
      &::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 8px;
        height: 2px;
        margin: -1px 0 0 -4px;
        background: $color-white;
        transition: transform $transition-base;
      }

      &::after {
        transform: rotate(90deg);
      }
    }

    &__item[open]:not(.is-closing) &__icon::after {
      transform: rotate(0deg);
    }

    // The outer element is what gets animated; overflow hides content mid-animation.
    &__answer {
      overflow: hidden;
    }

    &__answer-inner {
      padding: 0 1.5rem 1.5rem;
      font-family: $font-body;
      font-weight: 300;
      font-size: 0.95rem;
      letter-spacing: 1px;
      color: $color-text;
    }
  }
</style>
