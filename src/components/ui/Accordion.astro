---
// Q&A accordion, styled like the original (Divi accordion module).
// Built on <details>/<summary> so it works without JavaScript; the script
// adds the slide animation and keeps exactly one item open, as the original
// does (clicking the open item does nothing).
interface Item {
  question: string;
  answer: string[];
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className, ...rest } = Astro.props;
---

<div class:list={['accordion', className]} data-accordion {...rest}>
  {
    items.map((item, i) => (
      <details class="accordion__item" open={i === 0}>
        <summary class="accordion__question">{item.question}</summary>
        <div class="accordion__answer" data-accordion-answer>
          {item.answer.map((p) => <p>{p}</p>)}
        </div>
      </details>
    ))
  }
</div>

<script>
  const DURATION = 700; // Divi's slide speed
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function slide(item: HTMLDetailsElement, open: boolean) {
    const answer = item.querySelector<HTMLElement>('[data-accordion-answer]');
    if (open) item.open = true; // must be open to measure the content
    if (!answer || reduceMotion) {
      item.open = open;
      return;
    }
    const height = answer.offsetHeight;
    const frames = [{ height: '0px', paddingTop: '0px' }, { height: `${height}px` }];
    item.classList.toggle('is-closing', !open);
    answer.style.overflow = 'hidden';
    const animation = answer.animate(open ? frames : frames.reverse(), { duration: DURATION, easing: 'ease-in-out' });
    animation.onfinish = () => {
      answer.style.overflow = '';
      if (!open) item.open = false;
      item.classList.remove('is-closing');
    };
  }

  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((accordion) => {
    const items = [...accordion.querySelectorAll<HTMLDetailsElement>('details')];

    items.forEach((item) => {
      item.querySelector('summary')?.addEventListener('click', (event) => {
        event.preventDefault();
        if (item.open) return;
        items.filter((other) => other.open).forEach((other) => slide(other, false));
        slide(item, true);
      });
    });
  });
</script>

<style lang="scss">
  .accordion {
    &__item {
      padding: 20px;
      background: transparent;

      // Space between items: 2.75% of the row width on desktop.
      &:not(:last-child) {
        margin-bottom: 2.75%;

        @include tablet-down {
          margin-bottom: 10px;
        }
      }

      &[open]:not(.is-closing) {
        background: rgba(0, 0, 0, 0.03);
      }
    }

    // Closed: Noto Sans JP 15px with an orange "+" circle on the right.
    // Open: Montserrat 16px, no icon.
    &__question {
      position: relative;
      display: block;
      padding-right: 50px;
      @include font($font-body, 15px, 500, 1.5em, 1px);
      color: $color-heading;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }

      &::before,
      &::after {
        content: '';
        position: absolute;
        top: 50%;
        right: 0;
        width: 15px;
        height: 15px;
        margin-top: -7.5px;
      }

      &::before {
        border-radius: 50%;
        background: #f46624;
      }

      &::after {
        background:
          linear-gradient($color-white, $color-white) center / 9px 2px no-repeat,
          linear-gradient($color-white, $color-white) center / 2px 9px no-repeat;
      }
    }

    &__item[open]:not(.is-closing) &__question {
      font-family: $font-heading;
      font-size: 16px;

      &::before,
      &::after {
        display: none;
      }
    }

    &__answer {
      padding-top: 20px;
      @include font($font-body, 15px, 300, 1.8em, 1px);
      color: $color-text;

      p {
        padding-bottom: 15px;

        &:last-child {
          padding-bottom: 0;
        }
      }
    }
  }
</style>
