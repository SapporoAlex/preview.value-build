---
// Top of every inner page: a thin photo strip, then the centred page title.
// Anything passed in the default slot is shown as an intro paragraph.
//
// <PageHeader title="About Us" subtitle="バリュービルドについて" image="/images/photos/vb-010.jpeg" />
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
}

const { title, subtitle, image } = Astro.props;
const hasIntro = Astro.slots.has('default');
---

<div class="page-header">
  <div
    class="page-header__banner"
    style={image ? `background-image: url('${image}')` : undefined}
    role="presentation"
  >
  </div>

  <div class="page-header__body container">
    <h1 class="page-header__title" data-reveal="up">{title}</h1>
    {subtitle && (
      <p class="page-header__subtitle" data-reveal="up" style="--reveal-delay: 120ms">
        {subtitle}
      </p>
    )}
    {hasIntro && (
      <div class="page-header__intro prose" data-reveal="up" style="--reveal-delay: 240ms">
        <slot />
      </div>
    )}
  </div>
</div>

<style lang="scss">
  .page-header {
    &__banner {
      height: clamp(100px, 14vw, 200px);
      background-color: $color-grey-light;
      background-size: cover;
      background-position: center;

      // Gentle parallax feel on large screens (no JS needed).
      @include mq(lg) {
        background-attachment: fixed;
      }
    }

    &__body {
      padding-block: clamp(2.5rem, 6vw, 4.25rem) clamp(1rem, 3vw, 2rem);
      text-align: center;
    }

    &__title {
      @include text-page-title;
    }

    &__subtitle {
      @include text-page-subtitle;
      margin-top: 1rem;
    }

    &__intro {
      @include text-intro;
      max-width: $container-narrow;
      margin: 2rem auto 0;
      text-align: left;

      @include mq(lg) {
        text-align: justify;
      }
    }
  }
</style>
