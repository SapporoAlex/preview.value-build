---
// Section heading. Two looks, both taken from the original design:
//
//   variant="label"   (default) small orange centred label
//                     <SectionTitle title="Our Team" />
//   variant="display" very large dark heading, left aligned, optional subtitle
//                     <SectionTitle variant="display" title="8 Steps" subtitle="投資前のサポート" italic />
interface Props {
  title: string;
  subtitle?: string;
  variant?: 'label' | 'display';
  italic?: boolean; // display headings on How We Invest are italic
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  reveal?: 'up' | 'fade' | 'flip'; // scroll animation (see _reveal.scss)
}

const { title, subtitle, variant = 'label', italic = false, as: Tag = 'h2', reveal = 'up' } = Astro.props;
const align = Astro.props.align ?? (variant === 'label' ? 'center' : 'left');
---

<header
  class:list={[
    'section-title',
    `section-title--${variant}`,
    `section-title--${align}`,
    { 'section-title--italic': italic },
  ]}
  data-reveal={reveal}
>
  <Tag class="section-title__heading">{title}</Tag>
  {subtitle && <p class="section-title__subtitle">{subtitle}</p>}
</header>

<style lang="scss">
  .section-title {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);

    &--center {
      text-align: center;
    }

    // --- Small orange label ---
    &--label &__heading {
      @include text-section-label;
    }

    &--label &__subtitle {
      @include text-subheading;
      margin-top: 1rem;
      color: $color-navy;
    }

    // --- Large dark display heading ---
    &--display &__heading {
      @include text-display;
    }

    &--display &__subtitle {
      @include text-display-subtitle;
      margin-top: 0.75rem;
    }

    &--italic &__heading,
    &--italic &__subtitle {
      font-style: italic;
    }
  }
</style>
