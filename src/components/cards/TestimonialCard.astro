---
// Entrepreneur testimonial. The text is folded to a 64px preview with a
// centred "続きを読む" (read more) control that unfolds it, as on the original
// (a CSS-only checkbox; the checkbox stays focusable for keyboard users).
import type { Testimonial } from '@data/invest';
import Lines from '@components/ui/Lines.astro';

interface Props {
  testimonial: Testimonial;
  id: string;
}

const { testimonial, id } = Astro.props;
---

<div class:list={['testimonial mod', `testimonial--${testimonial.theme}`]}>
  <div class:list={{ 'hide-tablet': testimonial.emptyOnTablet }}>
    <p class="testimonial__who"><b>{testimonial.company}<br />{testimonial.person}</b></p>
    <div class="testimonial__body">
      <input class="testimonial__toggle" id={id} type="checkbox" />
      {testimonial.phoneExtraLine && <span class="testimonial__gap hide-desktop hide-tablet"></span>}
      <label class="testimonial__more" for={id}><span class="visually-hidden">{testimonial.company}の</span>続きを読む</label>
      <div class="testimonial__text">
        {
          testimonial.textPhone ? (
            <>
              <span class="hide-phone"><Lines text={testimonial.text} /></span>
              <span class="hide-desktop hide-tablet"><Lines text={testimonial.textPhone} /></span>
            </>
          ) : (
            <Lines text={testimonial.text} />
          )
        }
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  .testimonial {
    --bg: #{$color-white};

    padding: 1.8em;
    line-height: 1.8;
    background: var(--bg);

    &--orange {
      --bg: #{$color-orange};
      color: $color-white;
    }

    &--grey {
      --bg: #{$color-grey-light};
    }

    &--white {
      border: 1px solid $color-teal;
    }

    &--black {
      --bg: #{$color-black};
      color: $color-white;
    }

    &__body {
      position: relative;
    }

    &__toggle {
      @include visually-hidden;
    }

    // One empty line (phone versions of some boxes on the original).
    &__gap {
      display: block;
      height: 1.8em;
    }

    // Folded text with a fade into the background colour at the bottom.
    &__text {
      position: relative;
      max-height: 64px;
      margin-top: 1.2em;
      overflow: hidden;
      transition: max-height 0.8s ease;

      &::before {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 40px;
        background: linear-gradient(
          to bottom,
          color-mix(in srgb, var(--bg) 0%, transparent) 0%,
          color-mix(in srgb, var(--bg) 90%, transparent) 50%,
          var(--bg) 100%
        );
        transition: opacity 0.5s ease;
      }
    }

    &__more {
      position: absolute;
      bottom: 0;
      z-index: 10;
      display: block;
      width: 100%;
      height: 1.5em;
      text-align: center;
      cursor: pointer;
    }

    &--white &__more,
    &--grey &__more {
      color: $color-black;
    }

    &--orange &__more,
    &--black &__more {
      color: $color-white;
    }

    &__toggle:focus-visible ~ &__more {
      outline: 2px solid $color-teal;
    }

    &__toggle:checked ~ &__more {
      display: none;
    }

    &__toggle:checked ~ &__text {
      max-height: 1000px;

      &::before {
        opacity: 0;
      }
    }
  }
</style>
