---
// Photo + name + description (Tourism portfolio). With `url`, the whole
// card links out in a new tab, as on the original.
import type { TourismCompany } from '@data/portfolio';

interface Props {
  company: TourismCompany;
}

const { company } = Astro.props;
const Tag = company.url ? 'a' : 'div';
const link = company.url ? { href: company.url, target: '_blank', rel: 'noopener' } : {};
---

<Tag class="photo-card" {...link}>
  <img class="photo-card__image" src={company.image} alt="" width="550" height="367" loading="lazy" />
  <h4 class="photo-card__name">{company.name}</h4>
  <div class="photo-card__text">
    {company.paragraphs.map((p) => <p>{p}</p>)}
    {company.blankLine && <p>&nbsp;</p>}
  </div>
</Tag>

<style lang="scss">
  // Content is at most 550px wide and centred (Divi blurb default).
  .photo-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    max-width: 550px;
    margin: 0 auto;
    font-size: 15px;
    line-height: 1.6em;
    letter-spacing: 1px;
    color: $color-text;

    &__image {
      width: 100%;
      height: auto;
      margin-bottom: 30px;
    }

    &__name {
      @include font($font-body, 18px, 500, 2.3em, 1px);
    }
  }
</style>
