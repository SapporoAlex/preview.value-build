---
// Photo + title + description card (Tourism portfolio).
// The image zooms gently on hover. With `url`, photo and title link out.
interface Props {
  title: string;
  image: string;
  url?: string;
  paragraphs: string[];
  delay?: number;
}

const { title, image, url, paragraphs, delay = 0 } = Astro.props;
const Wrapper = url ? 'a' : 'div';
const linkProps = url ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<article class="photo-card" data-reveal="fade" style={`--reveal-delay: ${delay}ms`}>
  <Wrapper class="photo-card__link" {...linkProps}>
    <div class="photo-card__media">
      <img src={image} alt={title} loading="lazy" />
    </div>
    <h3 class="photo-card__title">{title}</h3>
  </Wrapper>
  <div class="photo-card__text prose">
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</article>

<style lang="scss">
  .photo-card {
    &__link {
      display: block;
      color: inherit;
    }

    &__media {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: $color-grey-light;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s $ease-out;
      }
    }

    &:hover &__media img {
      transform: scale(1.06);
    }

    &__title {
      margin-top: 1.25rem;
      font-family: $font-body;
      font-size: 1.125rem; // 18px
      font-weight: 500;
      letter-spacing: 1px;
      color: $color-text-strong;
    }

    &__text {
      margin-top: 0.75rem;
      font-family: $font-accent;
      font-weight: 500;
      font-size: 0.9375rem; // 15px
      line-height: 1.8;
      letter-spacing: 1px;
      color: $color-text;
    }
  }
</style>
