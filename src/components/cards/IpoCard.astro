---
// IPO track record entry (home page). The whole card is a link.
// Padding differs per layout, so the page sets it through `class`.
import type { HTMLAttributes } from 'astro/types';
import type { IpoCompany } from '@data/home';

interface Props extends HTMLAttributes<'a'> {
  company: IpoCompany;
  tablet?: boolean; // use the tablet copy of the history line
}

const { company, tablet = false, class: className, ...rest } = Astro.props;
---

<a class:list={['ipo-card', className]} href={company.href} {...rest}>
  <div class="ipo-card__logo">{company.logo && <img src={company.logo} alt="" loading="lazy" />}</div>
  <h4 class="ipo-card__name">{company.name}</h4>
  <div class="ipo-card__text">
    <p>{company.market}</p>
    <p class="ipo-card__detail">{company.description}<br />{tablet ? company.historyTablet : company.history}</p>
  </div>
</a>

<style lang="scss">
  .ipo-card {
    display: block;
    @include font($font-body, 13px, 300, 1.8em, 4px);
    color: $color-black;
    text-transform: uppercase;
    text-align: left;

    // Logo area (60% wide). The original's logo files are missing, which
    // leaves a 17px empty line; kept so the layout matches.
    &__logo {
      max-width: 60%;
      min-height: 17px;
      margin-bottom: 30px;

      img {
        width: 100%;
      }
    }

    &__name {
      @include font($font-body, 16px, 500, 1.5em, 4px);
      color: $color-black;
      text-transform: uppercase;
    }

    p {
      line-height: 1.8em;
    }

    &__detail {
      font-size: 12px;
    }
  }
</style>
