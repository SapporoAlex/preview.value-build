---
// Card linking to another portfolio category
// (the "Other Categories & Portfolio" block). Coloured rules top and bottom.
interface Props {
  title: string;
  href?: string;
  accent?: 'orange' | 'teal';
  delay?: number;
}

const { title, href, accent = 'orange', delay = 0 } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['category-card', `category-card--${accent}`]}
  href={href}
  data-reveal="up"
  style={`--reveal-delay: ${delay}ms`}
>
  <h3 class="category-card__title">{title}</h3>
  {href && <span class="category-card__more">MORE<span aria-hidden="true">ー</span></span>}
</Tag>

<style lang="scss">
  .category-card {
    --accent: #{$color-orange};

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 170px;
    padding: 2rem 1.5rem;
    background: $color-white;
    border-block: 2px solid var(--accent);
    text-align: center;
    transition:
      transform $transition-base,
      box-shadow $transition-base;

    &--teal {
      --accent: #{$color-teal};
    }

    &:is(a):hover,
    &:is(a):focus-visible {
      transform: translateY(-4px);
      box-shadow: $shadow-card;
    }

    &__title {
      @include text-card-title;
      color: $color-navy;
    }

    &__more {
      font-family: $font-heading;
      font-weight: 300;
      font-size: 1rem;
      letter-spacing: 2px;
      color: $color-navy;
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color $transition-fast;
    }

    &:hover &__more {
      color: var(--accent);
    }
  }
</style>
