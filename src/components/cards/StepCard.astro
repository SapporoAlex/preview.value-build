---
// Investment step (How We Invest page): small icon, coloured title, text.
// `accent` sets the title colour; `titleSize` matches the original's
// slightly different title styles ("tall" = 2em line height, "small" = 19px).
import type { InvestStep } from '@data/invest';

interface Props {
  step: InvestStep;
  accent: 'navy' | 'orange' | 'teal';
  titleSize?: 'normal' | 'tall' | 'small';
}

const { step, accent, titleSize = 'normal' } = Astro.props;
---

<div class="step__icon mod"><img src={step.icon} alt="" width="274" height="274" loading="lazy" /></div>
<div class="step mod">
  <h4 class:list={['step__title', `step__title--${accent}`, `step__title--${titleSize}`]}>{step.title}</h4>
  {step.paragraphs.map((p) => <p>{p}</p>)}
</div>

<style lang="scss">
  .step {
    padding: 7px 25px 7px 20px;
    @include font($font-body, null, 300, null, 1px);

    &__icon {
      width: 20%;
      padding-top: 20px;

      @include phone {
        padding-top: 10px;
      }

      img {
        width: 100%;
        height: auto;
      }
    }

    &__title {
      @include font($font-heading, 20px, 500, null, 2px);

      &--navy {
        color: $color-navy;
      }

      &--orange {
        color: $color-orange;
      }

      &--teal {
        color: $color-teal;
      }

      &--tall {
        line-height: 2em;
      }

      &--small {
        font-size: 19px;
      }
    }
  }
</style>
