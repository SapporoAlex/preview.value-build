---
// Team member profile (About page): oval portrait, name, role, location and bio.
// Card padding/background differ per card, so the page sets them via `class`.
import type { HTMLAttributes } from 'astro/types';
import type { TeamMember } from '@data/about';

interface Props extends HTMLAttributes<'div'> {
  member: TeamMember;
}

const { member, class: className, ...rest } = Astro.props;
const [width, height] = member.photoSize;
---

<div class:list={['team-card', className]} {...rest}>
  <div class="team-card__photo">
    <img src={member.photo} alt={member.name} width={width} height={height} loading="lazy" />
  </div>
  <h4 class="team-card__name">{member.name}</h4>
  <p class="team-card__role">{member.role}</p>
  <div class="team-card__bio">
    <p class:list={['team-card__location', { 'is-left-mobile': member.locationLeftOnMobile }]}>{member.location}</p>
    {member.bio.map((p) => <p>{p}</p>)}
  </div>
</div>

<style lang="scss">
  .team-card {
    height: 100%;
    letter-spacing: 1px;
    text-align: center;

    // Oval portrait, 250px wide even when the card is narrower (as on the
    // original), full card width on tablets.
    &__photo {
      width: 250px;
      margin: 0 auto 20px;
      overflow: hidden;
      border-radius: 190px;
      line-height: 0;

      @include tablet {
        width: auto;
        margin: 0 0 12px;
      }

      img {
        width: 100%;
        height: auto;
      }
    }

    &__name {
      @include font($font-heading, 18px, 500, null, 1px);
    }

    &__role {
      color: #aaa;
    }

    &__bio p:not(.team-card__location) {
      text-align: left;
    }

    .is-left-mobile {
      @include tablet-down {
        text-align: left;
      }
    }
  }
</style>
