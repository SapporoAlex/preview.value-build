---
// White-outlined tile on the navy band (home page). The whole tile is a link.
// Padding and letter spacing vary slightly per tile, so the page can pass a class.
import type { HTMLAttributes } from 'astro/types';
import Lines from '@components/ui/Lines.astro';

interface Props extends HTMLAttributes<'a'> {
  title: string; // "\n" = line break
  href: string;
  newTab?: boolean;
}

const { title, href, newTab = false, class: className, ...rest } = Astro.props;
---

<a class:list={['tile', className]} href={href} target={newTab ? '_blank' : undefined} {...rest}>
  <p class="tile__title"><Lines text={title} /></p>
</a>

<style lang="scss">
  .tile {
    display: block;
    padding: 30px;
    border: 3px solid $color-white;
    @include font($font-body, 16px, 500, 1.8em, 6px);
    color: $color-white;
    text-align: center;
    text-transform: uppercase;

    // Space left by the original's (empty) icon above the text.
    &::before {
      content: '';
      display: block;
      height: 21px;
      margin-bottom: 30px;
    }
  }
</style>
