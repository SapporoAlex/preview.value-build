---
// The page shell used by every page: <head>, header, footer and global scripts.
import '@styles/global.scss';
import SiteHeader from '@components/layout/SiteHeader.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import { site } from '@data/site';

interface Props {
  title?: string;
  description?: string;
  preloadImage?: string; // main image at the top of the page, fetched early for faster loading
}

const { title, description = site.description, preloadImage } = Astro.props;
const pageTitle = title ? `${title} - ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={site.logo} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint: text shows straight away
         in a fallback font and swaps when the web font arrives. -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Share+Tech&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Share+Tech&display=swap" /></noscript>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="site-main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>

<style lang="scss">
  // Pushes content below the header (fixed on desktop, 80px bar on mobile).
  .site-main {
    padding-top: $header-height;

    @include tablet-down {
      padding-top: $header-height-mobile - 1px;
    }
  }
</style>
